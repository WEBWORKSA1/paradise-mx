{% extends "base.html.j2" %}
{% block content %}
<section class="dest-hero"><div class="wrap">
  <h1>Mexico packing list</h1>
  <p class="lede">Tick your trip types and month for a checklist you can print or tick off on your phone.</p>
</div></section>
<section class="band-tight"><div class="wrap split">
  <form class="panel form" id="pack-tool" onsubmit="return false">
    <fieldset class="field"><legend>Trip includes</legend><div class="opts">
      <label class="opt"><input type="checkbox" name="pk-type" value="beach" checked><span>Beach</span></label>
      <label class="opt"><input type="checkbox" name="pk-type" value="cenotes"><span>Cenotes</span></label>
      <label class="opt"><input type="checkbox" name="pk-type" value="city"><span>Cities</span></label>
      <label class="opt"><input type="checkbox" name="pk-type" value="adventure"><span>Jungle and hiking</span></label>
      <label class="opt"><input type="checkbox" name="pk-type" value="wedding"><span>Wedding</span></label>
    </div></fieldset>
    <div class="field"><label for="pk-month">Month</label><select id="pk-month">{% for m in MONTHS_LONG %}<option value="{{ loop.index0 }}">{{ m }}</option>{% endfor %}</select></div>
    <label class="consent"><input type="checkbox" id="pk-kids"> Travelling with children</label>
    <button class="btn btn-quiet" type="button" id="pk-print">Print my list</button>
  </form>
  <div><h2>Your list</h2><div id="pk-out"></div></div>
</div></section>
{% endblock %}
