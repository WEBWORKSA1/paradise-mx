{% extends "base.html.j2" %}
{% block content %}
<section class="dest-hero"><div class="wrap">
  <h1>Trip tools</h1>
  <p class="lede">Small, free tools that answer the questions people ask before booking Mexico.</p>
</div></section>
<section class="band-tight"><div class="wrap">
  <div class="guides">
    <article class="guide"><h3><a href="{{ root }}#finder">Paradise Finder</a></h3><p>Rank 38 destinations for the month you can travel.</p></article>
    <article class="guide"><h3><a href="{{ root }}best-time/">Best-time matrix</a></h3><p>Every destination, every month, in one colour-coded table.</p></article>
    <article class="guide"><h3><a href="{{ root }}tools/compare/">Compare destinations</a></h3><p>Put up to three places side by side, month by month.</p></article>
    <article class="guide"><h3><a href="{{ root }}tools/trip-cost/">Trip cost estimator</a></h3><p>Flights, stay, food and tours for your group size and style.</p></article>
    <article class="guide"><h3><a href="{{ root }}tools/currency/">Peso converter</a></h3><p>Live US dollar, Canadian dollar, euro and pound rates.</p></article>
    <article class="guide"><h3><a href="{{ root }}tools/sargassum/">Sargassum outlook</a></h3><p>Typical seaweed exposure by month, with seaweed-free alternatives.</p></article>
    <article class="guide"><h3><a href="{{ root }}tools/packing/">Packing list</a></h3><p>A printable checklist for beaches, cenotes, cities and weddings.</p></article>
    <article class="guide"><h3><a href="{{ root }}calendar/">Seasons calendar</a></h3><p>Whales, turtles, festivals and storms, month by month.</p></article>
  </div>
</div></section>
{% endblock %}
